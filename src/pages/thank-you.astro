---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
    title="Request received | Augusto Llopis"
    description="Your private omakase request has been received."
>
    <section class="section-space text-center">
        <div class="container-shell">
            <p class="section-kicker mx-auto w-fit">Request received</p>

            <h1
                class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink md:text-5xl"
            >
                Thank you.
            </h1>

            <p class="mx-auto mt-5 max-w-xl text-ink/75">
                I will get back to you within 24–48 hours to confirm details and
                availability.
            </p>

            <a
                href="/"
                class="mt-8 inline-flex rounded-full border border-gold bg-gold px-7 py-3 text-sm font-semibold text-white transition hover:border-ember hover:bg-ember"
            >
                Back to home
            </a>
        </div>
    </section>
</BaseLayout>
