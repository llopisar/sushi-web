<section id="contact" class="section-space">
  <div class="container-shell grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div
      class="rounded-3xl border border-ink/10 bg-white/75 p-8 shadow-soft md:p-10"
    >
      <p class="section-kicker">Contact</p>
      <h2 class="section-heading">
        Tell me about the experience you have in mind.
      </h2>

      <p class="mt-5 text-sm leading-relaxed text-ink/80">
        Share a few details about your occasion and I will get back to you with
        availability and a tailored proposal.
      </p>

      <ul class="mt-7 space-y-3 text-sm text-ink/75">
        <li>Response within 24 to 48 hours</li>
        <li>Available in Spanish, Portuguese and English</li>
        <li>Private dining experiences in Porto and surrounding areas</li>
      </ul>
    </div>

    <form
      id="reservation-form"
      class="rounded-3xl border border-ink/10 bg-white p-8 shadow-soft md:p-10"
      novalidate
    >
      <div class="grid gap-5 md:grid-cols-2">
        <div class="md:col-span-1">
          <label class="mb-2 block text-sm font-medium text-ink" for="name"
            >Full name</label
          >
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-xl border border-ink/20 bg-white px-4 py-3 text-sm focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/30"
          />
        </div>

        <div class="md:col-span-1">
          <label class="mb-2 block text-sm font-medium text-ink" for="email"
            >Email</label
          >
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-xl border border-ink/20 bg-white px-4 py-3 text-sm focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/30"
          />
        </div>

        <div class="md:col-span-1">
          <label class="mb-2 block text-sm font-medium text-ink" for="phone"
            >Phone / WhatsApp</label
          >
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            class="w-full rounded-xl border border-ink/20 bg-white px-4 py-3 text-sm focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/30"
          />
        </div>

        <div class="md:col-span-1">
          <label class="mb-2 block text-sm font-medium text-ink" for="occasion"
            >Occasion</label
          >
          <select
            id="occasion"
            name="occasion"
            required
            class="w-full rounded-xl border border-ink/20 bg-white px-4 py-3 text-sm focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/30"
          >
            <option value="">Select an option</option>
            <option value="private-dinner">Private dinner</option>
            <option value="anniversary">Anniversary</option>
            <option value="special-occasion">Special occasion</option>
            <option value="hosting-at-home">Hosting at home</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="md:col-span-1">
          <label class="mb-2 block text-sm font-medium text-ink" for="date"
            >Approximate date</label
          >
          <input
            id="date"
            name="date"
            type="date"
            required
            class="w-full rounded-xl border border-ink/20 bg-white px-4 py-3 text-sm focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/30"
          />
        </div>

        <div class="md:col-span-1">
          <label class="mb-2 block text-sm font-medium text-ink" for="guests"
            >Number of guests</label
          >
          <select
            id="guests"
            name="guests"
            required
            class="w-full rounded-xl border border-ink/20 bg-white px-4 py-3 text-sm focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/30"
          >
            <option value="">Select</option>
            <option value="2">2 guests</option>
            <option value="3-4">3–4 guests</option>
            <option value="5-6">5–6 guests</option>
          </select>
        </div>

        <div class="md:col-span-2">
          <label class="mb-2 block text-sm font-medium text-ink" for="message"
            >Message</label
          >
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Tell me about the occasion, the approximate location and any relevant details."
            class="w-full rounded-xl border border-ink/20 bg-white px-4 py-3 text-sm focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/30"
          ></textarea>
        </div>
      </div>

      <p id="form-status" class="mt-4 text-sm text-ink/80" aria-live="polite">
      </p>

      <button
        type="submit"
        class="mt-6 inline-flex items-center justify-center rounded-full border border-gold bg-gold px-7 py-3 text-sm font-semibold text-white transition hover:border-ember hover:bg-ember"
      >
        Request Experience
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector("#reservation-form");
  const status = document.querySelector("#form-status");

  if (
    form instanceof HTMLFormElement &&
    status instanceof HTMLParagraphElement
  ) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        status.textContent =
          "Please complete the required fields before submitting.";
        status.className = "mt-4 text-sm text-ember";
        form.reportValidity();
        return;
      }

      status.textContent =
        "Your request has been sent successfully. I will get back to you soon.";
      status.className = "mt-4 text-sm text-green-700";
      form.reset();
    });
  }
</script>
