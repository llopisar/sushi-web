<section id="contact" class="section-space">
  <div class="container-shell grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <!-- Info -->
    <div
      class="rounded-3xl border border-ink/10 bg-white/75 p-8 shadow-soft md:p-10"
    >
      <p class="section-kicker">Contact</p>
      <h2 class="section-heading">
        Tell me about the experience you have in mind.
      </h2>

      <p class="mt-5 text-sm leading-relaxed text-ink/80">
        Share a few details about your occasion and I will get back to you with
        availability and a tailored proposal.
      </p>

      <ul class="mt-7 space-y-3 text-sm text-ink/75">
        <li>Response within 24 to 48 hours</li>
        <li>Available in Spanish, Portuguese and English</li>
        <li>Private dining experiences in Porto and surrounding areas</li>
      </ul>
    </div>

    <!-- Form -->
    <form
      name="reservation"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="rounded-3xl border border-ink/10 bg-white p-8 shadow-soft md:p-10"
    >
      <!-- Netlify hidden fields -->
      <input type="hidden" name="form-name" value="reservation" />
      <input type="hidden" name="bot-field" />

      <div class="grid gap-5 md:grid-cols-2">
        <div>
          <label class="mb-2 block text-sm font-medium text-ink"
            >Full name</label
          >
          <input
            name="name"
            type="text"
            required
            class="w-full rounded-xl border border-ink/20 px-4 py-3 text-sm focus:border-gold focus:ring-2 focus:ring-gold/30"
          />
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-ink">Email</label>
          <input
            name="email"
            type="email"
            required
            class="w-full rounded-xl border border-ink/20 px-4 py-3 text-sm focus:border-gold focus:ring-2 focus:ring-gold/30"
          />
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-ink"
            >Phone (optional)</label
          >
          <input
            name="phone"
            type="tel"
            class="w-full rounded-xl border border-ink/20 px-4 py-3 text-sm focus:border-gold focus:ring-2 focus:ring-gold/30"
          />
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-ink">Guests</label>
          <select
            name="guests"
            required
            class="w-full rounded-xl border border-ink/20 px-4 py-3 text-sm focus:border-gold focus:ring-2 focus:ring-gold/30"
          >
            <option value="">Select</option>
            <option value="2">2 guests</option>
            <option value="3-4">3–4 guests</option>
            <option value="5-6">5–6 guests</option>
          </select>
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-ink"
            >Approximate date</label
          >
          <input
            name="date"
            type="date"
            required
            class="w-full rounded-xl border border-ink/20 px-4 py-3 text-sm focus:border-gold focus:ring-2 focus:ring-gold/30"
          />
        </div>

        <div class="md:col-span-2">
          <label class="mb-2 block text-sm font-medium text-ink">Message</label>
          <textarea
            name="message"
            rows="4"
            placeholder="Tell me about the occasion and any relevant details."
            class="w-full rounded-xl border border-ink/20 px-4 py-3 text-sm focus:border-gold focus:ring-2 focus:ring-gold/30"
          ></textarea>
        </div>
      </div>

      <!-- Status -->
      <p id="form-status" class="mt-4 text-sm text-ink/80"></p>

      <button
        type="submit"
        class="mt-6 rounded-full bg-gold px-7 py-3 text-sm font-semibold text-white hover:bg-ember transition"
      >
        Request Experience
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector("form[name='reservation']");
  const status = document.getElementById("form-status");

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = new FormData(form);

      try {
        await fetch("/", {
          method: "POST",
          body: data,
        });

        status.textContent = "Thank you. I’ll get back to you shortly.";
        status.className = "mt-4 text-sm text-green-700";
        form.reset();
      } catch (error) {
        status.textContent = "Something went wrong. Please try again.";
        status.className = "mt-4 text-sm text-red-600";
      }
    });
  }
</script>
