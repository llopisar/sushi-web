---
const steps = [
  {
    title: "Share your plans",
    text: "Tell me about the occasion, your preferred date and the number of guests so I can understand the kind of experience you are looking for.",
  },
  {
    title: "Receive your proposal",
    text: "I will get back to you with availability, experience details and a tailored proposal based on your occasion and group size.",
  },
  {
    title: "Confirm your dinner",
    text: "Once everything is confirmed, I take care of the preparation and service so you can enjoy a calm and memorable evening at home.",
  },
];
---

<section id="process" class="section-space">
  <div
    class="container-shell rounded-3xl border border-ink/10 bg-ink px-8 py-14 text-white md:px-12"
  >
    <p class="section-kicker !border-white/30 !bg-white/10 !text-white">
      How it works
    </p>

    <h2 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">
      A simple and personal process.
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        steps.map((step, idx) => (
          <article class="rounded-2xl border border-white/20 bg-white/5 p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold">
              Step {idx + 1}
            </p>

            <h3 class="mt-3 font-display text-3xl leading-tight">
              {step.title}
            </h3>

            <p class="mt-4 text-sm leading-relaxed text-white/80">
              {step.text}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
