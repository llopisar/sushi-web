---
interface GalleryImage {
  src: string;
  alt: string;
}

const gallery: GalleryImage[] = [
  {
    src: "https://images.unsplash.com/photo-1579871494447-9811cf80d66c?auto=format&fit=crop&w=900&q=80",
    alt: "Elegant sushi presentation on ceramic plate",
  },
  {
    src: "https://images.unsplash.com/photo-1617196034796-73dfa7b1fd56?auto=format&fit=crop&w=900&q=80",
    alt: "Nigiri being prepared and served",
  },
  {
    src: "https://images.unsplash.com/photo-1553621042-f6e147245754?auto=format&fit=crop&w=900&q=80",
    alt: "Fresh sushi selection with minimal plating",
  },
  {
    src: "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=80",
    alt: "Private dining table setup",
  },
  {
    src: "https://images.unsplash.com/photo-1607301405390-1dbf8f0f3c17?auto=format&fit=crop&w=900&q=80",
    alt: "Chef serving sushi in a private setting",
  },
  {
    src: "https://images.unsplash.com/photo-1616671276441-2f2c277b8bf4?auto=format&fit=crop&w=900&q=80",
    alt: "Seasonal sashimi detail with clean presentation",
  },
];
---

<section id="gallery" class="section-space">
  <div class="container-shell">
    <div class="max-w-2xl">
      <p class="section-kicker">Gallery</p>
      <h2 class="section-heading">Moments from the experience.</h2>
    </div>

    <div class="mt-12 md:mt-14 grid grid-cols-2 gap-4 md:grid-cols-3">
      {
        gallery.map((image, index) => (
          <div
            class={`overflow-hidden rounded-2xl border border-ink/10 ${
              index % 4 === 0 ? "md:row-span-2" : ""
            }`}
          >
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              class="h-full min-h-[220px] w-full object-cover opacity-95 transition duration-500 hover:scale-[1.03] hover:opacity-100"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
